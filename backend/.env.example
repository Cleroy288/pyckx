IP=127.0.0.1
PORT=8080

# == SUPABASE CONFIGURATION // ==
SP_ID=
SP_URL=
SP_ANON=
SP_SERVICE_ROLE=
SECURE_HTTP=false

# == FRONTEND SERVING (production only) // ==
# Set to "true" to serve frontend static files from STATIC_DIR
# Set to "false" for development (frontend runs separately with proxy)
SERVE_FRONTEND=false
STATIC_DIR=./static

# == TEST CREDENTIALS (for integration tests only) // ==
TEST_EMAIL=
TEST_PSSWRD=

# == ALLOWED USERS ==
# Format: name1,email1,password1;name2,email2,password2
# Only users in this list can login/register
ALLOWED_USERS=

# == REDIS (session storage) ==
REDIS_URL=redis://127.0.0.1:6379

# == AUTH MICROSERVICE ==
AUTH_SERVICE_URL=http://127.0.0.1:3001

# == PYTHON BACKEND ==
PY_HOST=127.0.0.1
PY_PORT=8001
