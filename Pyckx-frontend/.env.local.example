# == API Configuration - Single Source of Truth for all API URLs // ==
# Copy this file to .env.local and customize as needed

# Base URL - leave empty for same-origin requests (production)
# Set to backend URL during development (e.g., http://localhost:8080)
NEXT_PUBLIC_API_BASE_URL=

# == Auth Endpoints // ==
NEXT_PUBLIC_AUTH_LOGIN=/auth/login
NEXT_PUBLIC_AUTH_REGISTER=/auth/register
NEXT_PUBLIC_AUTH_LOGOUT=/auth/logout

# == User Endpoints // ==
NEXT_PUBLIC_USER_ME=/user/me

# == Apps Endpoints // ==
NEXT_PUBLIC_APPS_LIST=/api/apps
NEXT_PUBLIC_APPS_USER=/api/user/apps

# == Collection Endpoints // ==
NEXT_PUBLIC_COLLECTION_BASE=/app/collection
NEXT_PUBLIC_COLLECTION_ADD_DVD=/app/collection/add-dvd
NEXT_PUBLIC_COLLECTION_GET_USER_DVDS=/app/collection/get-user-dvd
# Dynamic endpoints (use {id} as placeholder, replaced at runtime)
NEXT_PUBLIC_COLLECTION_GET_DVD=/app/collection/dvd/{id}
NEXT_PUBLIC_COLLECTION_UPDATE_DVD=/app/collection/mod-dvd/{id}
NEXT_PUBLIC_COLLECTION_DELETE_DVD=/app/collection/del/{id}

# == Backend URL for Development Proxy // ==
# Used in next.config.mjs rewrites (server-side only)
BACKEND_URL=http://localhost:8080

# == Security Configuration // ==
# SECURITY_MODE controls security headers behavior:
#   - "development" : No HSTS, relaxed for local dev (default)
#   - "production"  : Enables HSTS with preload (requires HTTPS)
# 
# WARNING: Only set to "production" when deploying with valid SSL certificate!
# HSTS will force browsers to use HTTPS for 1 year.
SECURITY_MODE=development

# == Build Mode Configuration // ==
# BUILD_MODE controls how Next.js builds the application:
#   - "development" : Normal dev mode with HMR and proxy (default)
#   - "export"      : Static HTML export for Rust backend serving
#
# For production build with Rust backend:
#   BUILD_MODE=export bun run build
# Then copy the "out" folder to backend/static
BUILD_MODE=development
